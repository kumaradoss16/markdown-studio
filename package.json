{
  "name": "markforge-markdown-studio",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node scripts/lint-check.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa": "node scripts/run-docs-qa.js",
    "qa:ci": "node scripts/run-docs-qa.js --profile ci-blocking --format json --out qa-report.json",
    "build:win": "node scripts/build-windows.js",
    "pack:source": "node scripts/package-source.js",
    "tauri": "tauri",
    "icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.4",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "codemirror": "^6.0.1",
    "dompurify": "^3.2.4",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7",
    "happy-dom": "^21.0.3",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^25.14.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "overrides": {
    "tinypool": "^2.2.0",
    "@vitest/mocker": "^4.1.12"
  }
}
